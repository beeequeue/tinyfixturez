{
	"name": "tinyfixturez",
	"description": "A tiny library for building and using file fixtures in tests",
	"type": "module",
	"version": "0.0.4",
	"license": "MIT",
	"author": "BeeeQueue <adam@haglund.dev>",
	"repository": "beeequeue/tinyfixturez",
	"packageManager": "pnpm@11.0.3",
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,json5,yaml,yml,css,scss,md}": [
			"oxfmt --write --no-error-on-unmatched-pattern"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "./node_modules/.bin/lint-staged"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint --flag unstable_native_nodejs_ts_config",
		"lint:format": "oxfmt --check",
		"test": "vitest",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"when-exit": "^2.1.5"
	},
	"devDependencies": {
		"@antfu/eslint-config": "8.2.0",
		"@changesets/changelog-github": "1.0.0-next.1",
		"@changesets/cli": "3.0.0-next.1",
		"@tsconfig/node22": "22.0.5",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "25.6.0",
		"@typescript/native-preview": "7.0.0-dev.20260430.1",
		"empathic": "2.0.0",
		"eslint": "10.2.1",
		"lint-staged": "16.4.0",
		"oxfmt": "0.47.0",
		"pathe": "2.0.3",
		"publint": "0.3.18",
		"simple-git-hooks": "2.13.1",
		"tsdown": "0.22.0-beta.2",
		"vitest": "4.1.5"
	},
	"inlinedDependencies": {
		"empathic": "2.0.0"
	}
}
